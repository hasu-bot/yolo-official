{
  "redirects": [
    {
      "source": "/model",
      "destination": "/model/",
      "permanent": true
    },
    {
      "source": "/history",
      "destination": "/history/",
      "permanent": true
    },
    {
      "source": "/casting",
      "destination": "/casting/",
      "permanent": true
    },
    {
      "source": "/hub/",
      "destination": "https://community.creativeyolo.com/",
      "permanent": false
    },
    {
      "source": "/hub",
      "destination": "https://community.creativeyolo.com/",
      "permanent": false
    },
    {
      "source": "/hub/:path*",
      "destination": "https://community.creativeyolo.com/:path*",
      "permanent": false
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/talents",
      "destination": "/api/talents-page"
    },
    {
      "source": "/talents/",
      "destination": "/api/talents-page"
    },
    {
      "source": "/talents/:slug/",
      "destination": "/api/talents-page?slug=:slug"
    },
    {
      "source": "/talents/:slug",
      "destination": "/api/talents-page?slug=:slug"
    }
  ]
}
